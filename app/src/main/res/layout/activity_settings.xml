<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="←  Settings"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customize your TourVista experience"
            android:textSize="14sp"
            android:textColor="?android:textColorSecondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="28dp" />

        <!-- ACCOUNT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/settingProfile"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="👤"
                android:textSize="22sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your personal information"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/settingNotifications"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:layout_marginTop="1dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="🔔"
                android:textSize="22sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notificationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Notifications"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:id="@+id/notificationSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trip reminders and updates"
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/notificationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ON"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

        </LinearLayout>


        <!-- APP PREFERENCES -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APP PREFERENCES"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />


        <LinearLayout
            android:id="@+id/settingLanguage"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="🌐"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Language"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/languageValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginStart="8dp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/settingAppearance"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:layout_marginTop="1dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="🎨"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Appearance"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/appearanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginStart="8dp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/settingLocation"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:layout_marginTop="1dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="📍"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Location Services"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/locationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enabled"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary" />

        </LinearLayout>


        <!-- TRAVEL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRAVEL"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />


        <LinearLayout
            android:id="@+id/settingFavorites"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="❤️"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Favorites"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/settingTrips"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:layout_marginTop="1dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="🧳"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="My Trips"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <!-- SUPPORT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUPPORT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp" />


        <LinearLayout
            android:id="@+id/settingHelp"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="❓"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Help &amp; Support"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/settingAbout"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:layout_marginTop="1dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="ℹ️"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="About TourVista"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/settingPrivacy"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?android:colorBackground"
            android:layout_marginTop="1dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:text="🔒"
                android:textSize="22sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Privacy Policy"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:text="›"
                android:textSize="28sp"
                android:textColor="?android:textColorSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>


        <!-- LOGOUT -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🚪  Logout"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:backgroundTint="?android:colorBackground"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>