<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- TOURVISTA LOGO -->
        <ImageView
            android:layout_width="155dp"
            android:layout_height="155dp"
            android:src="@drawable/tourvista_logo"
            android:scaleType="centerInside"
            android:contentDescription="TourVista Logo" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to TourVista"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:gravity="center" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Discover India, one journey at a time."
            android:textSize="16sp"
            android:textColor="#546E7A"
            android:gravity="center" />

        <!-- DESCRIPTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Explore beautiful destinations, plan your trips and discover amazing experiences with TourVista."
            android:textSize="14sp"
            android:textColor="#78909C"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="35dp" />

        <!-- CREATE ACCOUNT BUTTON -->
        <Button
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:textAllCaps="false"
            android:elevation="3dp" />

        <!-- LOGIN BUTTON -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Login"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:backgroundTint="#E3F1FF"
            android:textAllCaps="false"
            android:elevation="1dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <!-- FOOTER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your journey. Your India. Your TourVista."
            android:textSize="12sp"
            android:textColor="#90A4AE"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>