<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="←  Back"
            android:textColor="#1976D2"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingEnd="16dp" />

        <!-- Logo -->
        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:src="@drawable/tourvista_logo"
            android:scaleType="centerInside"
            android:contentDescription="TourVista Logo" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Help &amp; Support"
            android:textColor="#1565C0"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We're here to make your TourVista journey easier."
            android:textColor="#607D8B"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <!-- Getting Started -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Getting Started"
            android:textColor="#1565C0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="TourVista helps you discover destinations, explore travel information, save places and create your own trips. Use the Home and Explore sections to start discovering India."
            android:textColor="#455A64"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <!-- FAQ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Frequently Asked Questions"
            android:textColor="#1565C0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- FAQ 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="How can I explore destinations?"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Open the Home or Explore section to browse destinations. You can also use the search bar and category filters to find places based on your interests."
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- FAQ 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="How can I save a destination?"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Open a destination to view its details and select Add to Favorites. Your saved destinations can be accessed from the Favorites section."
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- FAQ 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="How can I create a trip?"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Open My Trips and select Plan Trip. Enter your destination, travel dates, number of travellers and trip type, then create your trip."
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- FAQ 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="How can I edit my profile?"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Open your Profile from the menu and select Edit Profile. You can update your name, email, phone number and travel preferences."
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- FAQ 5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="I forgot my password. What should I do?"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="On the Login page, select Forgot Password and enter your registered email address. You can then create a new password."
            android:textColor="#607D8B"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Settings Help"
            android:textColor="#1565C0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="You can use Settings to manage your profile, notifications, language, appearance, location preferences, favorites, trips and other TourVista options."
            android:textColor="#455A64"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <!-- Contact -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Contact Support"
            android:textColor="#1565C0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="If you experience a problem while using TourVista, please reach out to the TourVista support team. We can assist with account access, trip planning, app features and general questions."
            android:textColor="#455A64"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp" />

        <!-- Support Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="📧  support@tourvista.com"
            android:textColor="#1976D2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Final Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Happy Travelling! ✈️"
            android:textColor="#1976D2"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Explore. Plan. Discover."
            android:textColor="#90A4AE"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>