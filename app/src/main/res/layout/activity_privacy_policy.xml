<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="← Back"
            android:textColor="#1976D2"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Privacy &amp; Policy"
            android:textColor="#123B6D"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Intro -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your privacy matters to us. This Privacy Policy explains how TourVista handles information when you use the app."
            android:textColor="#555555"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="1. Information We Collect"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TourVista may store information that you provide while creating an account or using app features, such as your name, email address, profile information, trip details, and saved destinations."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. How We Use Information"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="The information provided by you may be used to provide app features, manage your account, personalize your travel experience, save trips and favorites, and improve TourVista."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Account Security"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="You are responsible for keeping your account credentials secure. TourVista is designed to keep your account information within the app and should not be used to share sensitive personal information."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 4 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="4. Saved Trips &amp; Favorites"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Trip plans and favorite destinations may be stored so that you can access them while using TourVista."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 5 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="5. Third-Party Services"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Some features may use third-party services or external platforms. Their handling of information is governed by their own privacy policies."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 6 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="6. Data Protection"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="We aim to protect the information used by TourVista. However, no digital system can guarantee complete security."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 7 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="7. Changes to This Policy"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="This Privacy Policy may be updated when TourVista introduces new features or changes how information is handled."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Section 8 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="8. Contact"
            android:textColor="#123B6D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="If you have questions about this Privacy Policy or TourVista, you can contact the TourVista support team through the Help &amp; Support section."
            android:textColor="#555555"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- Bottom -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="TourVista • Privacy &amp; Policy"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>